# ============================================================
# GhostTalk — Variáveis de Ambiente do Servidor
# ============================================================
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA comite o arquivo .env no repositório.

# ------------------------------------------------------------
# Servidor
# ------------------------------------------------------------
# Porta onde o servidor vai escutar
PORT=4000

# Ambiente de execução: development | production | test
NODE_ENV=development

# URL do frontend (para configuração do CORS)
CLIENT_URL=http://localhost:5173

# ------------------------------------------------------------
# Banco de Dados (MongoDB)
# ------------------------------------------------------------
# Exemplo Railway:  mongodb://user:pass@containers-us-west-X.railway.app:PORT/ghosttalk
# Exemplo Atlas:    mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/ghosttalk
MONGODB_URI=mongodb://localhost:27017/ghosttalk

# ------------------------------------------------------------
# JWT — Tokens de Autenticação
# ------------------------------------------------------------
# Segredo para assinar o access token (use string aleatória longa)
JWT_SECRET=TROQUE_POR_UMA_STRING_MUITO_SECRETA_E_ALEATORIA

# Validade do access token (ex: 15m, 1h)
JWT_EXPIRES_IN=15m

# Segredo para assinar o refresh token (use string diferente do JWT_SECRET)
JWT_REFRESH_SECRET=TROQUE_POR_OUTRO_SEGREDO_DIFERENTE

# Validade do refresh token (ex: 7d, 30d)
JWT_REFRESH_EXPIRES_IN=7d

# ------------------------------------------------------------
# Upload de Arquivos / Fotos de Perfil
# ------------------------------------------------------------
# Diretório local para armazenar uploads (relativo à raiz do server/)
UPLOAD_DIR=uploads

# Tamanho máximo de upload em bytes (padrão: 5 MB)
MAX_FILE_SIZE=5242880

# ------------------------------------------------------------
# Rate Limiting
# ------------------------------------------------------------
# Máximo de tentativas de login por janela de tempo
LOGIN_MAX_ATTEMPTS=5

# Janela de tempo em milissegundos (padrão: 1 minuto)
LOGIN_WINDOW_MS=60000

# ------------------------------------------------------------
# Mensagens Temporárias
# ------------------------------------------------------------
# Intervalo de limpeza automática de mensagens expiradas (em ms)
CLEANUP_INTERVAL_MS=3600000
